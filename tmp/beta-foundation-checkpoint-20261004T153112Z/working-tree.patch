+    shared.update(BUILD_DEFINITION)
+    shared.update(("backend/requirements-runtime.lock", "backend/requirements-render.lock"))
+    body = "".join(f"{p}\0{hashlib.sha256((root / p).read_bytes()).hexdigest()}\n"
+                   for p in sorted(shared))
