+}
+@keyframes cd-in {
+  0%   { transform: translateY(-80%); opacity: 0; filter: blur(4px); }
+  60%  { opacity: 1; filter: blur(0); text-shadow: 0 0 18px color-mix(in srgb, var(--accent) 75%, transparent); }
+  100% { transform: none; text-shadow: none; }
+}
+@keyframes cd-out {
+  to { transform: translateY(80%); opacity: 0; filter: blur(4px); }
+}
+.cd-sr {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+.cd-label {
+  font-family: var(--font-data);
+  font-size: clamp(11px, 9px + .3vw, 13px);
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  color: var(--ink-dim);
+}
+html:not(.js) .countdown { display: none; }
+@media (max-width: 400px) {
+  .cd-label { letter-spacing: .06em; }
+}
 
