# Protects the bridge-side forwarder. The proxy socket requires this, so the
# listener never exists without its restriction. The bridge only appears once
# the cluster is up, so startup waits for it rather than failing on a race.
[Unit]
Description=AegisForge C05 exposure controls for the runtime forwarder
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip -4 -o addr show cni0 | grep -q inet && exit 0; sleep 2; done; echo "cni0 never gained an address" >&2; exit 1'
ExecStart=/usr/local/lib/aegisforge/aegisforge-guard.sh apply ollama
ExecStop=/usr/local/lib/aegisforge/aegisforge-guard.sh remove ollama

[Install]
WantedBy=multi-user.target
